    <!-- 5. Две платформы с горками (Platforms and Ramps) -->
    <model name='platforms_and_ramps'>
      <static>1</static>
      <pose>-7.0 0.2 0 0 0 0</pose>
      <link name='platforms_link'>
        
        <!-- ГОРКА 1 -->
        <collision name='ramp1_col'><geometry><box><size>0.75 0.5 0.025</size></box></geometry><pose>0.402 0 0.1098 0 -0.35 0</pose></collision>
        <visual name='ramp1_vis'><geometry><box><size>0.75 0.5 0.025</size></box></geometry><pose>0.402 0 0.1098 0 -0.35 0</pose><material><script><name>Gazebo/Grey</name></script><ambient>0.4902 0.5176 0.5490 1</ambient><diffuse>0.4902 0.5176 0.5490 1</diffuse></material></visual>
        
        <!-- ПЛАТФОРМА 1 -->
        <collision name='plat1_top_col'><geometry><box><size>0.6 0.5 0.01</size></box></geometry><pose>1.05 0 0.245 0 0 0</pose></collision>
        <visual name='plat1_top_vis'><geometry><box><size>0.6 0.5 0.01</size></box></geometry><pose>1.05 0 0.245 0 0 0</pose><material><script><name>Gazebo/Grey</name></script><ambient>0.4902 0.5176 0.5490 1</ambient><diffuse>0.4902 0.5176 0.5490 1</diffuse></material></visual>
        
        <!-- Ножки платформы 1 (чёрные) -->
        <collision name='plat1_leg1_col'><geometry><box><size>0.05 0.05 0.25</size></box></geometry><pose>0.8 0.2 0.124 0 0 0</pose></collision>
        <visual name='plat1_leg1_vis'><geometry><box><size>0.05 0.05 0.25</size></box></geometry><pose>0.8 0.2 0.124 0 0 0</pose><material><script><name>Gazebo/Black</name></script></material></visual>
        <collision name='plat1_leg2_col'><geometry><box><size>0.05 0.05 0.25</size></box></geometry><pose>0.8 -0.2 0.124 0 0 0</pose></collision>
        <visual name='plat1_leg2_vis'><geometry><box><size>0.05 0.05 0.25</size></box></geometry><pose>0.8 -0.2 0.124 0 0 0</pose><material><script><name>Gazebo/Black</name></script></material></visual>
        <collision name='plat1_leg3_col'><geometry><box><size>0.05 0.05 0.25</size></box></geometry><pose>1.3 0.2 0.124 0 0 0</pose></collision>
        <visual name='plat1_leg3_vis'><geometry><box><size>0.05 0.05 0.25</size></box></geometry><pose>1.3 0.2 0.124 0 0 0</pose><material><script><name>Gazebo/Black</name></script></material></visual>
        <collision name='plat1_leg4_col'><geometry><box><size>0.05 0.05 0.25</size></box></geometry><pose>1.3 -0.2 0.124 0 0 0</pose></collision>
        <visual name='plat1_leg4_vis'><geometry><box><size>0.05 0.05 0.25</size></box></geometry><pose>1.3 -0.2 0.124 0 0 0</pose><material><script><name>Gazebo/Black</name></script></material></visual>

        <!-- СТУПЕНЬКА -->
        <collision name='step_col'><geometry><box><size>0.2 0.5 0.06</size></box></geometry><pose>1.45 0 0.28 0 0 0</pose></collision>
        <visual name='step_vis'><geometry><box><size>0.2 0.5 0.06</size></box></geometry><pose>1.45 0 0.28 0 0 0</pose><material><script><name>Gazebo/Grey</name></script><ambient>0.4902 0.5176 0.5490 1</ambient><diffuse>0.4902 0.5176 0.5490 1</diffuse></material></visual>
        
