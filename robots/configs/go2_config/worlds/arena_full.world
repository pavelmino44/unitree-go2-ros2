<sdf version='1.7'>
  <world name='default'>
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1</direction>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
              <torsional>
                <ode/>
              </torsional>
            </friction>
            <contact>
              <ode/>
            </contact>
            <bounce/>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <kinematic>0</kinematic>
        <gravity>1</gravity>
        <enable_wind>0</enable_wind>
      </link>
    </model>

    <!-- 1. А-образная горка (A-frame) -->
    <model name='a_frame_ramp'>
      <static>1</static>
      <pose>-3.9 4.4 0 0 0 0</pose>
      <link name='a_frame_link'>
        <!-- Левый скат (наклон 25 градусов = 0.436 рад). Смещен влево так, чтобы верхний край касался конька -->
        <collision name='ramp_left_collision'>
          <geometry><box><size>1.4 0.6 0.1</size></box></geometry>
          <pose>-0.713 0 0.209 0 -0.436 0</pose>
        </collision>
        <visual name='ramp_left_visual'>
          <geometry><box><size>1.4 0.6 0.1</size></box></geometry>
          <pose>-0.713 0 0.209 0 -0.436 0</pose>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <!-- Правый скат -->
        <collision name='ramp_right_collision'>
          <geometry><box><size>1.4 0.6 0.1</size></box></geometry>
          <pose>0.713 0 0.209 0 0.436 0</pose>
        </collision>
        <visual name='ramp_right_visual'>
          <geometry><box><size>1.4 0.6 0.1</size></box></geometry>
          <pose>0.713 0 0.209 0 0.436 0</pose>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <!-- Соединительная планка (конек). Поднята на высоту стыка скатов -->
        <collision name='peak_collision'>
          <geometry><box><size>0.2 0.6 0.1</size></box></geometry>
          <pose>0 0 0.5 0 0 0</pose>
        </collision>
        <visual name='peak_visual'>
          <geometry><box><size>0.2 0.6 0.1</size></box></geometry>
          <pose>0 0 0.5 0 0 0</pose>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 2. Подвесной мост (Suspension Bridge) -->
    <model name='suspension_bridge'>
      <static>1</static>
      <pose>-3.9 6.4 0 0 0 0</pose>
      <link name='bridge_link'>
        <!-- Настил (высота 0.25 м) -->
        <collision name='deck_collision'>
          <geometry><box><size>1.8 0.6 0.05</size></box></geometry>
          <pose>0 0 0.25 0 0 0</pose>
        </collision>
        <visual name='deck_visual'>
          <geometry><box><size>1.8 0.6 0.05</size></box></geometry>
          <pose>0 0 0.25 0 0 0</pose>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <!-- Опора 1 (слева) -->
        <collision name='post1_collision'>
          <geometry><box><size>0.1 0.1 0.25</size></box></geometry>
          <pose>-0.9 0 0.125 0 0 0</pose>
        </collision>
        <visual name='post1_visual'>
          <geometry><box><size>0.1 0.1 0.25</size></box></geometry>
          <pose>-0.9 0 0.125 0 0 0</pose>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <!-- Опора 2 (справа) -->
        <collision name='post2_collision'>
          <geometry><box><size>0.1 0.1 0.25</size></box></geometry>
          <pose>0.9 0 0.125 0 0 0</pose>
        </collision>
        <visual name='post2_visual'>
          <geometry><box><size>0.1 0.1 0.25</size></box></geometry>
          <pose>0.9 0 0.125 0 0 0</pose>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 3. Балансир-качели (Seesaw) -->
    <model name='balance_seesaw'>
      <pose>-3.9 8.4 0 0 0 0</pose>
      <!-- Основание (цилиндр) -->
      <link name='seesaw_base'>
        <!-- Делаем основание кинематическим, чтобы оно не падало под действием гравитации -->
        <kinematic>1</kinematic>
        <gravity>0</gravity>
        <collision name='base_collision'>
          <geometry><cylinder><radius>0.1</radius><length>0.6</length></cylinder></geometry>
          <!-- Цилиндр повернут на 90 градусов вокруг X, чтобы лежать поперек -->
          <pose>0 0 0.1 1.5708 0 0</pose>
        </collision>
        <visual name='base_visual'>
          <geometry><cylinder><radius>0.1</radius><length>0.6</length></cylinder></geometry>
          <pose>0 0 0.1 1.5708 0 0</pose>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
      
      <!-- Доска (динамическая, для качелей) -->
      <link name='seesaw_board'>
        <!-- Центрируем доску относительно шарнира (смещение 0 0 0) -->
        <collision name='board_collision'>
          <geometry><box><size>1.8 0.5 0.05</size></box></geometry>
          <pose>0 0 0.225 0 -0.1 0</pose> 
        </collision>
        <visual name='board_visual'>
          <geometry><box><size>1.8 0.5 0.05</size></box></geometry>
          <pose>0 0 0.225 0 -0.1 0</pose>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
      
      <!-- Шарнир. Расположен ровно на вершине цилиндра (Z = 0.1 + radius 0.1 = 0.2) -->
      <joint name='seesaw_joint' type='revolute'>
        <parent>seesaw_base</parent>
        <child>seesaw_board</child>
        <pose>0 0 0.2 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <!-- Ограничение качания +-5-8 градусов (в радианах это ~0.1) -->
          <!-- effort увеличен, чтобы вес робота мог провернуть доску -->
          <limit><lower>-0.1</lower><upper>0.1</upper><effort>100</effort><velocity>1</velocity></limit>
        </axis>
      </joint>
    </model>

    <!-- 4. Змейка вокруг конусов (Slalom Cones) -->
    <model name='slalom_cones'>
      <static>1</static>
      <pose>-3.9 2.4 0 0 0 0</pose>
      <!-- 6 конусов высотой 1 м, расстояние между ними 1 м -->
      <link name='cone_1'>
        <pose>0 0 0.5 0 0 0</pose>
        <collision name='col_1'><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name='vis_1'><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry><material><script><name>Gazebo/Orange</name></script></material></visual>
      </link>
      <link name='cone_2'>
        <pose>1.0 0 0.5 0 0 0</pose>
        <collision name='col_2'><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name='vis_2'><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry><material><script><name>Gazebo/Orange</name></script></material></visual>
      </link>
      <link name='cone_3'>
        <pose>2.0 0 0.5 0 0 0</pose>
        <collision name='col_3'><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name='vis_3'><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry><material><script><name>Gazebo/Orange</name></script></material></visual>
      </link>
      <link name='cone_4'>
        <pose>3.0 0 0.5 0 0 0</pose>
        <collision name='col_4'><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name='vis_4'><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry><material><script><name>Gazebo/Orange</name></script></material></visual>
      </link>
      <link name='cone_5'>
        <pose>4.0 0 0.5 0 0 0</pose>
        <collision name='col_5'><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name='vis_5'><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry><material><script><name>Gazebo/Orange</name></script></material></visual>
      </link>
      <link name='cone_6'>
        <pose>5.0 0 0.5 0 0 0</pose>
        <collision name='col_6'><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name='vis_6'><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry><material><script><name>Gazebo/Orange</name></script></material></visual>
      </link>
    </model>

        <!-- 5. Две платформы с горками (Platforms and Ramps) -->
    <model name='platforms_and_ramps'>
      <static>1</static>
      <pose>-3.9 0.4 0 0 0 0</pose>
      <link name='platforms_link'>
        
        <!-- ================= ГОРКА 1 (ВВЕРХ) ================= -->
        <!-- Длина 0.75 м, угол 20 градусов (0.35 рад), поднимает на высоту 0.25 м -->
        <collision name='ramp1_col'><geometry><box><size>0.75 0.5 0.025</size></box></geometry><pose>0.402 0 0.1098 0 -0.35 0</pose></collision>
        <visual name='ramp1_vis'><geometry><box><size>0.75 0.5 0.025</size></box></geometry><pose>0.402 0 0.1098 0 -0.35 0</pose><material><script><name>Gazebo/Grey</name></script></material></visual>
        
        <!-- ================= ПЛАТФОРМА 1 ================= -->
        <!-- Высота 0.25 м. Настил толщиной 0.01 м -->
        <collision name='plat1_top_col'><geometry><box><size>0.6 0.5 0.01</size></box></geometry><pose>1.05 0 0.245 0 0 0</pose></collision>
        <visual name='plat1_top_vis'><geometry><box><size>0.6 0.5 0.01</size></box></geometry><pose>1.05 0 0.245 0 0 0</pose><material><script><name>Gazebo/Grey</name></script></material></visual>
        
        <!-- Ножки платформы 1 (4 шт. по углам) -->
        <collision name='plat1_leg1_col'><geometry><box><size>0.05 0.05 0.25</size></box></geometry><pose>0.8 0.2 0.124 0 0 0</pose></collision>
        <visual name='plat1_leg1_vis'><geometry><box><size>0.05 0.05 0.25</size></box></geometry><pose>0.8 0.2 0.124 0 0 0</pose><material><script><name>Gazebo/DarkGrey</name></script></material></visual>
        <collision name='plat1_leg2_col'><geometry><box><size>0.05 0.05 0.25</size></box></geometry><pose>0.8 -0.2 0.124 0 0 0</pose></collision>
        <visual name='plat1_leg2_vis'><geometry><box><size>0.05 0.05 0.25</size></box></geometry><pose>0.8 -0.2 0.124 0 0 0</pose><material><script><name>Gazebo/DarkGrey</name></script></material></visual>
        <collision name='plat1_leg3_col'><geometry><box><size>0.05 0.05 0.25</size></box></geometry><pose>1.3 0.2 0.124 0 0 0</pose></collision>
        <visual name='plat1_leg3_vis'><geometry><box><size>0.05 0.05 0.25</size></box></geometry><pose>1.3 0.2 0.124 0 0 0</pose><material><script><name>Gazebo/DarkGrey</name></script></material></visual>
        <collision name='plat1_leg4_col'><geometry><box><size>0.05 0.05 0.25</size></box></geometry><pose>1.3 -0.2 0.124 0 0 0</pose></collision>
        <visual name='plat1_leg4_vis'><geometry><box><size>0.05 0.05 0.25</size></box></geometry><pose>1.3 -0.2 0.124 0 0 0</pose><material><script><name>Gazebo/DarkGrey</name></script></material></visual>

        <!-- ================= СТУПЕНЬКА ================= -->
        <!-- Поднимает на +0.12 м. Итоговая высота 0.37 м. Длина 0.2 м -->
        <collision name='step_col'><geometry><box><size>0.2 0.5 0.06</size></box></geometry><pose>1.45 0 0.28 0 0 0</pose></collision>
        <visual name='step_vis'><geometry><box><size>0.2 0.5 0.06</size></box></geometry><pose>1.45 0 0.28 0 0 0</pose><material><script><name>Gazebo/Grey</name></script></material></visual>
        
        <!-- ================= ПЛАТФОРМА 2 ================= -->
        <!-- Высота 0.37 м. Настил толщиной 0.01 м -->
        <collision name='plat2_top_col'><geometry><box><size>0.6 0.5 0.01</size></box></geometry><pose>1.85 0 0.365 0 0 0</pose></collision>
        <visual name='plat2_top_vis'><geometry><box><size>0.6 0.5 0.01</size></box></geometry><pose>1.85 0 0.365 0 0 0</pose><material><script><name>Gazebo/Grey</name></script></material></visual>
        
        <!-- Ножки платформы 2 (4 шт. по углам) -->
        <collision name='plat2_leg1_col'><geometry><box><size>0.05 0.05 0.37</size></box></geometry><pose>1.6 0.2 0.184 0 0 0</pose></collision>
        <visual name='plat2_leg1_vis'><geometry><box><size>0.05 0.05 0.37</size></box></geometry><pose>1.6 0.2 0.184 0 0 0</pose><material><script><name>Gazebo/DarkGrey</name></script></material></visual>
        <collision name='plat2_leg2_col'><geometry><box><size>0.05 0.05 0.37</size></box></geometry><pose>1.6 -0.2 0.184 0 0 0</pose></collision>
        <visual name='plat2_leg2_vis'><geometry><box><size>0.05 0.05 0.37</size></box></geometry><pose>1.6 -0.2 0.184 0 0 0</pose><material><script><name>Gazebo/DarkGrey</name></script></material></visual>
        <collision name='plat2_leg3_col'><geometry><box><size>0.05 0.05 0.37</size></box></geometry><pose>2.1 0.2 0.184 0 0 0</pose></collision>
        <visual name='plat2_leg3_vis'><geometry><box><size>0.05 0.05 0.37</size></box></geometry><pose>2.1 0.2 0.184 0 0 0</pose><material><script><name>Gazebo/DarkGrey</name></script></material></visual>
        <collision name='plat2_leg4_col'><geometry><box><size>0.05 0.05 0.37</size></box></geometry><pose>2.1 -0.2 0.184 0 0 0</pose></collision>
        <visual name='plat2_leg4_vis'><geometry><box><size>0.05 0.05 0.37</size></box></geometry><pose>2.1 -0.2 0.184 0 0 0</pose><material><script><name>Gazebo/DarkGrey</name></script></material></visual>

        <!-- ================= ГОРКА 2 (ВНИЗ) ================= -->
        <!-- Длина 0.75 м, угол 20 градусов (0.35 рад), спускает с высоты 0.37 м -->
        <collision name='ramp2_col'><geometry><box><size>1.10 0.5 0.025</size></box></geometry><pose>2.662 0 0.17 0 0.35 0</pose></collision>
        <visual name='ramp2_vis'><geometry><box><size>1.10 0.5 0.025</size></box></geometry><pose>2.662 0 0.17 0 0.35 0</pose><material><script><name>Gazebo/Grey</name></script></material></visual>
        
      </link>
    </model>

