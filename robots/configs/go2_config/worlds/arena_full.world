        <visual name='stripe1_vis_6'><geometry><cylinder><radius>0.041</radius><length>0.06</length></cylinder></geometry><pose>0 0 0.66 0 0 0</pose><material><script><name>Gazebo/White</name></script></material></visual>
        <visual name='stripe2_vis_6'><geometry><cylinder><radius>0.041</radius><length>0.06</length></cylinder></geometry><pose>0 0 0.54 0 0 0</pose><material><script><name>Gazebo/White</name></script></material></visual>
