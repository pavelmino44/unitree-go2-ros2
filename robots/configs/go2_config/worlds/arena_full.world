<sdf version='1.7'>
  <world name='default'>
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1</direction>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
              <torsional>
                <ode/>
              </torsional>
            </friction>
            <contact>
              <ode/>
            </contact>
            <bounce/>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <kinematic>0</kinematic>
        <gravity>1</gravity>
        <enable_wind>0</enable_wind>
      </link>
    </model>

        <!-- 1. А-образная горка (A-frame) -->
    <model name='a_frame_ramp'>
      <static>1</static>
      <pose>-8.0 3.0 0 0 0 1.57</pose>
      <link name='a_frame_link'>
        <collision name='ramp_left_collision'>
          <geometry><box><size>1.4 0.6 0.1</size></box></geometry>
          <pose>-0.713 0 0.209 0 -0.436 0</pose>
        </collision>
        <visual name='ramp_left_visual'>
          <geometry><box><size>1.4 0.6 0.1</size></box></geometry>
          <pose>-0.713 0 0.209 0 -0.436 0</pose>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.4902 0.5176 0.5490 1</ambient><diffuse>0.4902 0.5176 0.5490 1</diffuse></material>
        </visual>
        <collision name='ramp_right_collision'>
          <geometry><box><size>1.4 0.6 0.1</size></box></geometry>
          <pose>0.713 0 0.209 0 0.436 0</pose>
        </collision>
        <visual name='ramp_right_visual'>
          <geometry><box><size>1.4 0.6 0.1</size></box></geometry>
          <pose>0.713 0 0.209 0 0.436 0</pose>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.4902 0.5176 0.5490 1</ambient><diffuse>0.4902 0.5176 0.5490 1</diffuse></material>
        </visual>
        <collision name='peak_collision'>
          <geometry><box><size>0.2 0.6 0.1</size></box></geometry>
          <pose>0 0 0.5 0 0 0</pose>
        </collision>
        <visual name='peak_visual'>
          <geometry><box><size>0.2 0.6 0.1</size></box></geometry>
          <pose>0 0 0.5 0 0 0</pose>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.4902 0.5176 0.5490 1</ambient><diffuse>0.4902 0.5176 0.5490 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 2. Подвесной мост (Suspension Bridge) -->
    <model name='suspension_bridge'>
      <static>1</static>
      <pose>-4.5 8.5 0 0 0 0</pose>
      <link name='bridge_link'>
        <!-- Настил -->
        <collision name='deck_collision'>
          <geometry><box><size>1.8 0.6 0.05</size></box></geometry>
          <pose>0 0 0.25 0 0 0</pose>
        </collision>
        <visual name='deck_visual'>
          <geometry><box><size>1.8 0.6 0.05</size></box></geometry>
          <pose>0 0 0.25 0 0 0</pose>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.4902 0.5176 0.5490 1</ambient><diffuse>0.4902 0.5176 0.5490 1</diffuse></material>
        </visual>
        <!-- Опора 1 (чёрная) -->
        <collision name='post1_collision'>
          <geometry><box><size>0.1 0.1 0.25</size></box></geometry>
          <pose>-0.9 0 0.125 0 0 0</pose>
        </collision>
        <visual name='post1_visual'>
          <geometry><box><size>0.1 0.1 0.25</size></box></geometry>
          <pose>-0.9 0 0.125 0 0 0</pose>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material>
        </visual>
        <!-- Опора 2 (чёрная) -->
        <collision name='post2_collision'>
          <geometry><box><size>0.1 0.1 0.25</size></box></geometry>
          <pose>0.9 0 0.125 0 0 0</pose>
        </collision>
        <visual name='post2_visual'>
          <geometry><box><size>0.1 0.1 0.25</size></box></geometry>
          <pose>0.9 0 0.125 0 0 0</pose>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 3. Балансир-качели (Seesaw) -->
    <model name='balance_seesaw'>
      <pose>-8.0 7.0 0 0 0 -1.57</pose>
      
      <!-- Основание: две боковые опоры и цилиндр на вершине (всё чёрное) -->
      <link name='seesaw_base'>
        <kinematic>1</kinematic>
        <gravity>0</gravity>
        
        <!-- Левая опора (чёрная) -->
        <collision name='post_left_col'>
          <geometry><box><size>0.08 0.08 0.2</size></box></geometry>
          <pose>0 -0.26 0.1 0 0 0</pose>
        </collision>
        <visual name='post_left_vis'>
          <geometry><box><size>0.08 0.08 0.2</size></box></geometry>
          <pose>0 -0.26 0.1 0 0 0</pose>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material>
        </visual>
        
        <!-- Правая опора (чёрная) -->
        <collision name='post_right_col'>
          <geometry><box><size>0.08 0.08 0.2</size></box></geometry>
          <pose>0 0.26 0.1 0 0 0</pose>
        </collision>
        <visual name='post_right_vis'>
          <geometry><box><size>0.08 0.08 0.2</size></box></geometry>
          <pose>0 0.26 0.1 0 0 0</pose>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material>
        </visual>
        
        <!-- Ось вращения (светло-серая) -->
        <collision name='pivot_cylinder_col'>
          <geometry><cylinder><radius>0.01</radius><length>0.6</length></cylinder></geometry>
          <pose>0 0 0.2 1.5708 0 0</pose>
        </collision>
        <visual name='pivot_cylinder_vis'>
          <geometry><cylinder><radius>0.01</radius><length>0.6</length></cylinder></geometry>
          <pose>0 0 0.2 1.5708 0 0</pose>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
      
      <!-- Доска (динамическая). Новый цвет -->
      <link name='seesaw_board'>
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.104</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1.35</iyy>
            <iyz>0</iyz>
            <izz>1.45</izz>
          </inertia>
        </inertial>
        
        <collision name='board_collision'>
          <geometry><box><size>1.8 0.5 0.025</size></box></geometry>
          <pose>0 0 0.2225 0 -0.23 0</pose> 
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name='board_visual'>
          <geometry><box><size>1.8 0.5 0.025</size></box></geometry>
          <pose>0 0 0.2225 0 -0.23 0</pose>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><ambient>0.4902 0.5176 0.5490 1</ambient><diffuse>0.4902 0.5176 0.5490 1</diffuse></material>
        </visual>
      </link>
      
      <!-- Шарнир -->
      <joint name='seesaw_joint' type='revolute'>
        <parent>seesaw_base</parent>
        <child>seesaw_board</child>
        <pose>0 0 0.2 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-0.15</lower>
            <upper>0.15</upper>
            <effort>100</effort>
            <velocity>2</velocity>
          </limit>
          <dynamics>
            <damping>0.01</damping>
            <friction>0.01</friction>
          </dynamics>
        </axis>
      </joint>
    </model>

    <!-- 4. Змейка вокруг конусов (Slalom Cones) - НЕ ТРОГАЕМ -->
    <model name='slalom_cones'>
      <static>1</static>
      <pose>-3.0 1.0 0 0 0 1.571</pose>
      
      <link name='cone_1'>
        <pose>0 0 0 0 0 0</pose>
        <collision name='base_col_1'><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><pose>0 0 0.025 0 0 0</pose></collision>
        <visual name='base_vis_1'><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><pose>0 0 0.025 0 0 0</pose><material><script><name>Gazebo/Black</name></script></material></visual>
        <collision name='cone_col_1'><geometry><cylinder><radius>0.04</radius><length>0.7</length></cylinder></geometry><pose>0 0 0.40 0 0 0</pose></collision>
        <visual name='cone_vis_1'><geometry><cylinder><radius>0.04</radius><length>0.7</length></cylinder></geometry><pose>0 0 0.40 0 0 0</pose><material><script><name>Gazebo/Orange</name></script></material></visual>
        <visual name='stripe1_vis_1'><geometry><cylinder><radius>0.041</radius><length>0.06</length></cylinder></geometry><pose>0 0 0.66 0 0 0</pose><material><script><name>Gazebo/White</name></script></material></visual>
        <visual name='stripe2_vis_1'><geometry><cylinder><radius>0.041</radius><length>0.06</length></cylinder></geometry><pose>0 0 0.54 0 0 0</pose><material><script><name>Gazebo/White</name></script></material></visual>
        <visual name='stripe3_vis_1'><geometry><cylinder><radius>0.041</radius><length>0.06</length></cylinder></geometry><pose>0 0 0.42 0 0 0</pose><material><script><name>Gazebo/White</name></script></material></visual>
      </link>

      <link name='cone_2'>
        <pose>1.0 0 0 0 0 0</pose>
        <collision name='base_col_2'><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><pose>0 0 0.025 0 0 0</pose></collision>
        <visual name='base_vis_2'><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><pose>0 0 0.025 0 0 0</pose><material><script><name>Gazebo/Black</name></script></material></visual>
        <collision name='cone_col_2'><geometry><cylinder><radius>0.04</radius><length>0.7</length></cylinder></geometry><pose>0 0 0.40 0 0 0</pose></collision>
        <visual name='cone_vis_2'><geometry><cylinder><radius>0.04</radius><length>0.7</length></cylinder></geometry><pose>0 0 0.40 0 0 0</pose><material><script><name>Gazebo/Orange</name></script></material></visual>
        <visual name='stripe1_vis_2'><geometry><cylinder><radius>0.041</radius><length>0.06</length></cylinder></geometry><pose>0 0 0.66 0 0 0</pose><material><script><name>Gazebo/White</name></script></material></visual>
        <visual name='stripe2_vis_2'><geometry><cylinder><radius>0.041</radius><length>0.06</length></cylinder></geometry><pose>0 0 0.54 0 0 0</pose><material><script><name>Gazebo/White</name></script></material></visual>
        <visual name='stripe3_vis_2'><geometry><cylinder><radius>0.041</radius><length>0.06</length></cylinder></geometry><pose>0 0 0.42 0 0 0</pose><material><script><name>Gazebo/White</name></script></material></visual>
      </link>

      <link name='cone_3'>
        <pose>2.0 0 0 0 0 0</pose>
        <collision name='base_col_3'><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><pose>0 0 0.025 0 0 0</pose></collision>
        <visual name='base_vis_3'><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><pose>0 0 0.025 0 0 0</pose><material><script><name>Gazebo/Black</name></script></material></visual>
        <collision name='cone_col_3'><geometry><cylinder><radius>0.04</radius><length>0.7</length></cylinder></geometry><pose>0 0 0.40 0 0 0</pose></collision>
        <visual name='cone_vis_3'><geometry><cylinder><radius>0.04</radius><length>0.7</length></cylinder></geometry><pose>0 0 0.40 0 0 0</pose><material><script><name>Gazebo/Orange</name></script></material></visual>
        <visual name='stripe1_vis_3'><geometry><cylinder><radius>0.041</radius><length>0.06</length></cylinder></geometry><pose>0 0 0.66 0 0 0</pose><material><script><name>Gazebo/White</name></script></material></visual>
        <visual name='stripe2_vis_3'><geometry><cylinder><radius>0.041</radius><length>0.06</length></cylinder></geometry><pose>0 0 0.54 0 0 0</pose><material><script><name>Gazebo/White</name></script></material></visual>
        <visual name='stripe3_vis_3'><geometry><cylinder><radius>0.041</radius><length>0.06</length></cylinder></geometry><pose>0 0 0.42 0 0 0</pose><material><script><name>Gazebo/White</name></script></material></visual>
      </link>

      <link name='cone_4'>
        <pose>3.0 0 0 0 0 0</pose>
        <collision name='base_col_4'><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><pose>0 0 0.025 0 0 0</pose></collision>
        <visual name='base_vis_4'><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><pose>0 0 0.025 0 0 0</pose><material><script><name>Gazebo/Black</name></script></material></visual>
        <collision name='cone_col_4'><geometry><cylinder><radius>0.04</radius><length>0.7</length></cylinder></geometry><pose>0 0 0.40 0 0 0</pose></collision>
