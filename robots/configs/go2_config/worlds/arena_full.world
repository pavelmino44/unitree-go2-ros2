        <visual name='stripe1_vis_5'><geometry><cylinder><radius>0.041</radius><length>0.06</length></cylinder></geometry><pose>0 0 0.66 0 0 0</pose><material><script><name>Gazebo/White</name></script></material></visual>
        <visual name='stripe2_vis_5'><geometry><cylinder><radius>0.041</radius><length>0.06</length></cylinder></geometry><pose>0 0 0.54 0 0 0</pose><material><script><name>Gazebo/White</name></script></material></visual>
        <visual name='stripe3_vis_5'><geometry><cylinder><radius>0.041</radius><length>0.06</length></cylinder></geometry><pose>0 0 0.42 0 0 0</pose><material><script><name>Gazebo/White</name></script></material></visual>
      </link>

      <link name='cone_6'>
        <pose>5.0 0 0 0 0 0</pose>
        <collision name='base_col_6'><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><pose>0 0 0.025 0 0 0</pose></collision>
        <visual name='base_vis_6'><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><pose>0 0 0.025 0 0 0</pose><material><script><name>Gazebo/Black</name></script></material></visual>
        <collision name='cone_col_6'><geometry><cylinder><radius>0.04</radius><length>0.7</length></cylinder></geometry><pose>0 0 0.40 0 0 0</pose></collision>
