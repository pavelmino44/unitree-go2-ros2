        <visual name='stripe1_vis_4'><geometry><cylinder><radius>0.041</radius><length>0.06</length></cylinder></geometry><pose>0 0 0.66 0 0 0</pose><material><script><name>Gazebo/White</name></script></material></visual>
        <visual name='stripe2_vis_4'><geometry><cylinder><radius>0.041</radius><length>0.06</length></cylinder></geometry><pose>0 0 0.54 0 0 0</pose><material><script><name>Gazebo/White</name></script></material></visual>
        <visual name='stripe3_vis_4'><geometry><cylinder><radius>0.041</radius><length>0.06</length></cylinder></geometry><pose>0 0 0.42 0 0 0</pose><material><script><name>Gazebo/White</name></script></material></visual>
      </link>

      <link name='cone_5'>
        <pose>4.0 0 0 0 0 0</pose>
